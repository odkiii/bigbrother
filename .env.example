# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only these Telegram user ids can talk to the bot (comma-separated)
TELEGRAM_ALLOW_USER_IDS=
# Optional webhook guard: /api/telegram?secret=...
TELEGRAM_WEBHOOK_SECRET=

# Protect /api/check (external cron every 5 min)
CRON_SECRET=

# Protect /api/report (sites push errors)
REPORT_SECRET=

# Upstash Redis (free tier) — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override site list / probes as JSON
# SITES_JSON=
# PROBES_JSON=

# --- Per-site secrets (fill what you have) ---
# Onreza / MySQL examples:
# ZVEZDA_DATABASE_URL=mysql://user:pass@host:3306/db
# DOCTOR_DATABASE_URL=mysql://user:pass@host:3306/db

# Vercel / Postgres examples:
# KATERAMIKA_DATABASE_URL=postgres://...
# DEAL_POIZON_DATABASE_URL=postgres://...
# DROPTEXT_DATABASE_URL=postgres://...

# Optional internal API secrets referenced as "env:NAME" in probe headers:
# DEAL_POIZON_INTERNAL_SECRET=
