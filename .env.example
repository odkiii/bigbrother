# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only these Telegram user ids can talk to the bot (comma-separated)
TELEGRAM_ALLOW_USER_IDS=
# Optional webhook guard (query ?secret= and Telegram header x-telegram-bot-api-secret-token).
# Use only A-Za-z0-9_- so Telegram accepts it as secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Live public origin of this app, no trailing slash.
# Required if the Vercel production alias is wrong/dead (e.g. *.vercel.app 404).
# BIGBROTHER_PUBLIC_URL=https://your-app.vercel.app
# Auto-injected by Vercel when Protection Bypass for Automation is enabled.
# Needed if Deployment Protection (SSO) is on — otherwise Telegram gets 401.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Protect /api/check (external cron every 5 min)
CRON_SECRET=

# Protect /api/report (sites push errors)
REPORT_SECRET=

# Upstash Redis (free tier) — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override site list / probes as JSON
# SITES_JSON=
# PROBES_JSON=

# --- Per-site secrets (fill what you have) ---
# Onreza / MySQL examples:
# ZVEZDA_DATABASE_URL=mysql://user:pass@host:3306/db
# DOCTOR_DATABASE_URL=mysql://user:pass@host:3306/db

# Vercel / Postgres examples:
# KATERAMIKA_DATABASE_URL=postgres://...
# DEAL_POIZON_DATABASE_URL=postgres://...

# Optional internal API secrets referenced as "env:NAME" in probe headers:
# DEAL_POIZON_INTERNAL_SECRET=
