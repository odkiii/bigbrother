{
  "siteId": "zvezda-na-elku",
  "pages": [
    {
      "path": "/",
      "name": "homepage",
      "scanErrors": true,
      "checkAssets": true,
      "maxTtfbMs": 8000,
      "maxHtmlBytes": 2500000,
      "maxAssetMs": 8000,
      "maxAssetBytes": 1500000,
      "assert": [{ "selector": "body" }]
