    "maxPages": 8,
    "sameOrigin": true,
    "scanErrors": true,
    "checkAssets": true,
    "maxAssetMs": 8000
  },
  "forms": [],
  "apis": [],
  "databases": [
    {
      "name": "mysql-main",
      "driver": "mysql",
      "urlEnv": "ZVEZDA_DATABASE_URL",
      "query": "SELECT 1 AS ok"
    }
  ]
}
