{
  "siteId": "doctor-ekazheva",
  "pages": [
    {
      "path": "/",
      "name": "homepage",
      "scanErrors": true,
      "checkAssets": true,
      "maxTtfbMs": 8000,
      "maxAssetMs": 8000,
      "assert": [{ "selector": "body" }]
    }
  ],
  "crawl": {
    "startPath": "/",
    "maxPages": 8,
    "sameOrigin": true,
    "scanErrors": true,
    "checkAssets": true
  },
  "forms": [],
  "apis": [
    {
      "name": "course-form-api",
      "path": "/api/submit-course-form",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "XMLHttpRequest",
        "Origin": "https://doctor-ekazheva.ru",
        "Referer": "https://doctor-ekazheva.ru/"
      },
      "body": {
        "full_name": "",
        "phone": "",
        "course_name": "",
        "consent": true
      },
      "expectStatus": [400],
      "expectTextIncludes": "success",
      "severity": "critical",
      "maxMs": 12000
    }
  ],
  "databases": [
    {
      "name": "mysql-main",
      "driver": "mysql",
      "urlEnv": "DOCTOR_DATABASE_URL",
      "query": "SELECT 1 AS ok",
      "severity": "warning"
    }
  ]
}
